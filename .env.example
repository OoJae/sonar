# Sonar environment variables.
# Copy to .env.local for Next.js to pick them up. Never commit real values.
# Every var here is loaded and validated by lib/utils/env.ts.

# --- Core model access ------------------------------------------------------
# Xiaomi MiMo V2.5 Pro accessed via its Anthropic-compatible endpoint.
# We reuse @ai-sdk/anthropic with a custom baseURL pointing at the MiMo relay.
# Get a key + base URL from https://platform.xiaomimimo.com (Console > API Keys).
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic/v1

# --- SoSoValue REST API -----------------------------------------------------
# High Frequency tier is 100 requests per minute. Cache TTLs live in lib/sosovalue/cache.ts.
SOSOVALUE_API_KEY=
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com

# Flip to "live" once SOSOVALUE_API_KEY is set. Defaults to "fixture" so the
# dashboard and agent runner work without a key during development.
SONAR_DATA_SOURCE=fixture

# --- Postgres (Supabase) ----------------------------------------------------
# DATABASE_URL is the pooled connection string used by the app at runtime.
# DIRECT_URL is the direct connection string used by drizzle-kit migrations.
DATABASE_URL=
DIRECT_URL=

# --- Upstash Redis ----------------------------------------------------------
# Required for the SoSoValue cache and rate-limit token bucket.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Chain RPCs -------------------------------------------------------------
# Defaults are the public Base and ValueChain endpoints. Override with Alchemy
# or Ankr URLs for higher throughput. Both are read-only in Wave 1.
BASE_RPC_URL=https://mainnet.base.org
VALUECHAIN_RPC_URL=https://rpc.valuechain.xyz

# --- SoDEX live client (Wave 1: spot pair listing only) ---------------------
# SODEX_API_KEY is the mainnet registered-key NAME (not the master wallet key).
# Optional on testnet: testnet uses the master wallet private key directly,
# see docs/sodex-live.md §1.
SODEX_API_KEY=
SODEX_BASE_URL=https://api.sodex.com

# --- Wave 2 execution layer (SoDEX live + risk gate) ------------------------
# Execution mode:
#   "paper"        Wave 1 paper engine, no real orders, no funds at risk.
#   "live-testnet" Real signed orders to SoDEX testnet. Default for Wave 2 demo.
#   "live-mainnet" Hard-gated; also requires SONAR_ALLOW_MAINNET=true.
SONAR_EXECUTION_MODE=paper

# Mainnet opt-in. MUST be "true" when SONAR_EXECUTION_MODE=live-mainnet.
# Wave 2 keeps mainnet disabled; this stays empty for the demo.
SONAR_ALLOW_MAINNET=

# Forces a manual approval step before every live order. Always true on mainnet.
# Optional on testnet ("true" makes the dashboard the gating step before fills).
SONAR_REQUIRE_MANUAL_APPROVAL=false

# Notional caps in USD. The risk gate downsizes per-order requests and stops
# placing once the per-cycle total is breached.
SONAR_MAX_NOTIONAL_PER_ORDER=500
SONAR_MAX_NOTIONAL_PER_CYCLE=2000

# Wave 3 session-key delegation. When "true", every order must be covered by an
# active user-signed EIP-712 grant to the agent session key or the executor
# blocks it. Default off (autonomous cron trades under operator authority).
# Requires SODEX_WALLET_PRIVATE_KEY when true. Toggling needs an app restart.
SONAR_REQUIRE_DELEGATION=false
# Rate limit for the user-signed grant/revoke routes (count/windowSec).
SONAR_DELEGATION_RATELIMIT=20/60
# Rate limit for the public on-demand index-proposal generator (count/windowSec).
SONAR_PROPOSAL_RATELIMIT=5/600

# Macro circuit breaker lookahead window (hours). A high-impact macro event
# (CPI, FOMC) within this horizon makes the agent de-risk (cap + tilt to USSI).
SONAR_MACRO_HALT_HORIZON_HOURS=6

# Wave 3 production risk engine. When reconstructed book drawdown exceeds
# SONAR_MAX_DRAWDOWN_PCT, the cycle de-risks (same path as the macro breaker).
# SONAR_VAR_CONFIDENCE is the confidence level for the historical VaR on /risk.
SONAR_MAX_DRAWDOWN_PCT=25
SONAR_VAR_CONFIDENCE=0.95

# Interactive public run-a-cycle demo budget, "<count>/<windowSeconds>".
# Default 1 run per 300s globally. The /api/agent/demo-run endpoint enforces it.
SONAR_PUBLIC_RUN_RATELIMIT=1/300

# Live SoDEX testnet base. The client appends /spot or /perps per request.
# See docs/sodex-live.md §2 for the URL table.
SODEX_TESTNET_BASE_URL=https://testnet-gw.sodex.dev/api/v1

# Reserved for the mainnet auth flow. Testnet does NOT use a separate secret
# (signing key is SODEX_WALLET_PRIVATE_KEY directly). Leave empty for Wave 2.
SODEX_API_SECRET=

# Disposable testnet hot wallet private key. Server-side only, NEVER commit.
# Used by viem privateKeyToAccount() for EIP-712 signing of every SoDEX
# request. See docs/sodex-live.md §1 + §3.
SODEX_WALLET_PRIVATE_KEY=

# --- Chain reads and bridging (Wave 2 cross-chain) --------------------------
# USDC contract addresses on each chain. Base mainnet USDC is well-known (the
# default below); the ValueChain testnet USDC address is documented in
# docs/mirror-bridge.md §3 (currently UNCONFIRMED, pending Discord).
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VALUECHAIN_USDC_ADDRESS=

# Mirror Protocol bridge contracts. UNCONFIRMED until Discord clarification.
# See docs/mirror-bridge.md §5 for the open question.
MIRROR_BRIDGE_BASE_ADDRESS=
MIRROR_BRIDGE_VALUECHAIN_ADDRESS=

# WalletConnect Cloud project id. Public by design (NEXT_PUBLIC_ prefix).
# Get one free at https://cloud.walletconnect.com.
NEXT_PUBLIC_WALLETCONNECT_ID=

# --- Langfuse observability (Wave 2 traces) ---------------------------------
# The logger no-ops when these are absent. Wave 2 wires real per-cycle traces;
# /log restores its Trace column once these are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Cron protection --------------------------------------------------------
# Set any random string; both /api/cron/daily and /api/agent/run reject
# requests missing the matching Authorization: Bearer header.
CRON_SECRET=
