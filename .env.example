# Sonar environment variables.
# Copy to .env.local for Next.js to pick them up. Never commit real values.
# Every var here is loaded and validated by lib/utils/env.ts.

# --- Core model access ------------------------------------------------------
# Xiaomi MiMo V2.5 Pro accessed via its Anthropic-compatible endpoint.
# We reuse @ai-sdk/anthropic with a custom baseURL pointing at the MiMo relay.
# Get a key + base URL from https://platform.xiaomimimo.com (Console > API Keys).
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic/v1

# --- SoSoValue REST API -----------------------------------------------------
# High Frequency tier is 100 requests per minute. Cache TTLs live in lib/sosovalue/cache.ts.
SOSOVALUE_API_KEY=
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com

# Flip to "live" once SOSOVALUE_API_KEY is set. Defaults to "fixture" so the
# dashboard and agent runner work without a key during development.
SONAR_DATA_SOURCE=fixture

# --- Postgres (Supabase) ----------------------------------------------------
# DATABASE_URL is the pooled connection string used by the app at runtime.
# DIRECT_URL is the direct connection string used by drizzle-kit migrations.
DATABASE_URL=
DIRECT_URL=

# --- Upstash Redis ----------------------------------------------------------
# Required for the SoSoValue cache and rate-limit token bucket.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Chain RPCs -------------------------------------------------------------
# Defaults are the public Base and ValueChain endpoints. Override with Alchemy
# or Ankr URLs for higher throughput. Both are read-only in Wave 1.
BASE_RPC_URL=https://mainnet.base.org
# ValueChain TESTNET RPC (chainId 138565). The default mode is paper and the env
# guard rejects a mainnet RPC off mainnet, so this must be the testnet value; the
# mainnet RPC is written only by the mode drop-in (lib/admin/dropin.ts).
VALUECHAIN_RPC_URL=https://testnet.valuechain.xyz

# --- SoDEX live client ------------------------------------------------------
# SODEX_API_KEY is OPTIONAL and used only by the Wave 1 read-only spot-pair-list
# display (lib/sodex/client.ts listSpotPairs / healthCheck). Unset falls back to a
# static pair list. It is NOT a trading credential and NOT required on mainnet:
# probed 2026-07-17, mainnet trading signs exactly like testnet with the master
# wallet private key, no X-API-Key and no registration. (There is no
# scripts/sodex-mainnet-register.ts; the registered-key model was disproven and
# removed, see docs/sodex-live.md and the 2026-07-17 changelog.)
SODEX_API_KEY=
SODEX_BASE_URL=https://api.sodex.com

# --- Wave 2 execution layer (SoDEX live + risk gate) ------------------------
# Execution mode:
#   "paper"        Wave 1 paper engine, no real orders, no funds at risk.
#   "live-testnet" Real signed orders to SoDEX testnet. Default for Wave 2 demo.
#   "live-mainnet" Real funds. Every order is queued for human approval; the
#                  autonomous cycle can never submit one. Also requires
#                  SONAR_ALLOW_MAINNET=true, SONAR_REQUIRE_MANUAL_APPROVAL=true,
#                  and the ValueChain MAINNET USDC + RPC (see below). No API key:
#                  probed 2026-07-17, mainnet signs exactly like testnet with the
#                  master wallet, so SODEX_WALLET_PRIVATE_KEY is the only
#                  credential. (The old SODEX_API_KEY / SODEX_MAINNET_SIGNING_KEY
#                  registered-key model was disproven and removed.)
#
# The mode is a BOOT-TIME property: env() is cached for the process lifetime, so
# changing this takes a restart. That is deliberate. It is what makes the boot
# guard meaningful and what clears the per-venue caches in lib/sodex/client.ts.
# Do not add a runtime setter.
#
# Mainnet is NOT flipped by editing this line in production. POST /api/admin/mode
# writes /root/sonar/.env.mode (a systemd EnvironmentFile drop-in listed after
# this file, so it wins) and restarts. Kill switch:
#   rm /root/sonar/.env.mode && systemctl restart sonar
SONAR_EXECUTION_MODE=paper

# Mainnet opt-in. MUST be "true" when SONAR_EXECUTION_MODE=live-mainnet.
#
# Independent of the mode on purpose: this line is the deployment saying "this box
# is ALLOWED to go mainnet", and the signed admin toggle is the separate act that
# says "it is armed right now". Both are inert while the mode is not live-mainnet
# (every reader sits inside an `if (mode === "live-mainnet")`), so setting them
# true on a testnet box changes no behaviour.
SONAR_ALLOW_MAINNET=

# Forces a manual approval step before every live order. MUST be "true" on
# mainnet, where orders land as pending_approval and only the bearer-gated
# POST /api/orders/approve submits them.
SONAR_REQUIRE_MANUAL_APPROVAL=false

# Comma-separated 0x addresses allowed to flip the execution mode from the
# browser via POST /api/admin/mode. Auth is an EIP-712 signature recovered
# server-side and checked against this list.
#
# Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the client bundle, and
# there is no endpoint that returns it. Unset means the toggle is CLOSED for
# everyone, which is the right default for a public deployment.
#
# Weigh this before setting it: with an allowlist, arming real money stops
# requiring SSH access and starts requiring one key. That key is then the thing
# protecting the balance, and this venue has no revocable sub-key.
SONAR_ADMIN_ADDRESSES=

# Notional caps in USD. The risk gate downsizes per-order requests and stops
# placing once the per-cycle total is breached.
SONAR_MAX_NOTIONAL_PER_ORDER=500
SONAR_MAX_NOTIONAL_PER_CYCLE=2000

# Wave 3 session-key delegation. When "true", every order must be covered by an
# active user-signed EIP-712 grant to the agent session key or the executor
# blocks it. Default off (autonomous cron trades under operator authority).
# Requires SODEX_WALLET_PRIVATE_KEY when true. Toggling needs an app restart.
SONAR_REQUIRE_DELEGATION=false
# Rate limit for the user-signed grant/revoke routes (count/windowSec).
SONAR_DELEGATION_RATELIMIT=20/60
# Rate limit for the public on-demand index-proposal generator (count/windowSec).
SONAR_PROPOSAL_RATELIMIT=5/600
# Per-IP rate limit for the public read-only API v1 (count/windowSec).
SONAR_API_RATELIMIT=120/60

# Telegram notifications (optional; notify module no-ops without the token).
# Create the bot via @BotFather; make it an admin of your channel with the
# post-messages right. TELEGRAM_CHANNEL_ID is "@name" or "-100...". The webhook
# secret gates /api/telegram/webhook (openssl rand -hex 24) and is REQUIRED
# whenever the bot token is set. TELEGRAM_CHANNEL_URL is the public join link
# shown on the site.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_URL=

# X (Twitter) publisher (optional). OAuth 1.0a user-context keys from a
# pay-per-use developer app (the free tier ended Feb 2026; a post with a link
# bills ~$0.20). Workflow: paste keys -> run scripts/x-post-smoke.ts -> only
# then set X_AUTOPOST=true to publish each cycle's thesis summary.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_AUTOPOST=false

# Macro circuit breaker lookahead window (hours). A high-impact macro event
# (CPI, FOMC) within this horizon makes the agent de-risk (cap + tilt to USSI).
SONAR_MACRO_HALT_HORIZON_HOURS=6

# Wave 3 production risk engine. When reconstructed book drawdown exceeds
# SONAR_MAX_DRAWDOWN_PCT, the cycle de-risks (same path as the macro breaker).
# SONAR_VAR_CONFIDENCE is the confidence level for the historical VaR on /risk.
SONAR_MAX_DRAWDOWN_PCT=25
SONAR_VAR_CONFIDENCE=0.95

# Interactive public run-a-cycle demo budget, "<count>/<windowSeconds>".
# Default 1 run per 300s globally. The /api/agent/demo-run endpoint enforces it.
SONAR_PUBLIC_RUN_RATELIMIT=1/300

# Live SoDEX testnet base. The client appends /spot or /perps per request.
# See docs/sodex-live.md §2 for the URL table.
SODEX_TESTNET_BASE_URL=https://testnet-gw.sodex.dev/api/v1

# Live SoDEX mainnet base. Only read on live-mainnet. Keep the /api/v1 suffix.
SODEX_MAINNET_BASE_URL=https://mainnet-gw.sodex.dev/api/v1

# Unused. Neither testnet nor mainnet uses a separate API secret; both sign with
# the master wallet private key (SODEX_WALLET_PRIVATE_KEY). Leave empty.
SODEX_API_SECRET=

# Master wallet private key. Server-side only, NEVER commit.
# Signs EVERY signed request on BOTH venues; there is no separate mainnet key
# and no addAPIKey ceremony (probed 2026-07-17; docs/sodex-live.md 5.3 was
# wrong). Testnet: a disposable hot wallet. Mainnet: the account owner that also
# holds the funds, so this key IS the blast radius. Keep the balance symbolic.
SODEX_WALLET_PRIVATE_KEY=


# --- Chain reads and bridging ----------------------------------------------
# USDC contract addresses on each chain. Base mainnet USDC is well-known (the
# default below). VALUECHAIN_USDC_ADDRESS is the SoDEX margin asset: the
# testnet USDC on live-testnet, the ValueChain MAINNET USDC on live-mainnet
# (REQUIRED there). Funding the venue is a direct deposit, not a bridge hop.
#
# VALUECHAIN_RPC_URL and VALUECHAIN_USDC_ADDRESS are single vars shared across
# modes, so SWAP THEM TOGETHER when flipping to live-mainnet. Confirmed values
# (probed 2026-07-17, see docs/mirror-bridge.md section 3):
#   testnet  RPC  https://testnet.valuechain.xyz    chainId 138565
#   testnet  USDC 0x3fFe1743c2Cb5C9c9ED23d8CF62dD7aFABD4eE05
#   mainnet  RPC  https://rpc.valuechain.xyz        chainId 286623
#   mainnet  USDC 0xcb7F80Dff2727c791fA491722c428e6657f7e2c6  (SoDexToken: USDC)
# Swapping one without the other reads a token on a chain that does not host it:
# no code, balance renders 0, and 0 is also the legitimate by-design value, so
# the mistake is silent.
#
# This is now ENFORCED rather than advisory: lib/utils/env.ts binds both values to
# the mode at boot and refuses to start on a mismatch, in either direction. The
# old check only tested that VALUECHAIN_USDC_ADDRESS was PRESENT, which .env.local
# always satisfied, so it could never fire. If you flip the mode by hand, expect
# the boot to fail until all three agree. In production the drop-in written by
# POST /api/admin/mode carries all three together (lib/admin/dropin.ts).
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VALUECHAIN_USDC_ADDRESS=

# Mirror Protocol bridge contracts. Still UNCONFIRMED pending Discord, so the
# bridge stays dormant and is NOT on the funding path. Setting both lights up
# tx assembly. See docs/mirror-bridge.md §5 for the open question.
MIRROR_BRIDGE_BASE_ADDRESS=
MIRROR_BRIDGE_VALUECHAIN_ADDRESS=

# WalletConnect Cloud project id. Public by design (NEXT_PUBLIC_ prefix).
# Get one free at https://cloud.walletconnect.com.
NEXT_PUBLIC_WALLETCONNECT_ID=

# --- Langfuse observability (Wave 2 traces) ---------------------------------
# The logger no-ops when these are absent. Wave 2 wires real per-cycle traces;
# /log restores its Trace column once these are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Cron protection --------------------------------------------------------
# Set any random string; both /api/cron/daily and /api/agent/run reject
# requests missing the matching Authorization: Bearer header.
CRON_SECRET=
