[Unit]
Description=Sonar - ETF-flow-aware agentic hedge fund (Next.js)
Documentation=https://github.com/OoJae/sonar
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/sonar
EnvironmentFile=/root/sonar/.env.local
# Optional mode drop-in, written by POST /api/admin/mode to arm live-mainnet.
# MUST stay AFTER .env.local: systemd reads EnvironmentFile directives in order
# and the later assignment wins. The "-" makes a missing file a non-error, which
# is what makes the kill switch `rm /root/sonar/.env.mode && systemctl restart
# sonar`: no file means the process boots on the .env.local baseline (testnet).
# No ExecStartPre validator here on purpose: systemd reads EnvironmentFile BEFORE
# ExecStartPre runs, so a drop-in removed there would not change ExecStart's env
# in the same start attempt. instrumentation.ts is where a bad drop-in is caught.
EnvironmentFile=-/root/sonar/.env.mode
# PORT must match the upstream nginx proxy_pass (127.0.0.1:3005). Restart
# semantics: always restart with a short backoff so a single crash does not
# leave the public URL dead during judging week.
Environment=PORT=3005
Environment=NODE_ENV=production
# pnpm under nvm needs PATH so its node shim resolves. Update both lines on
# Node version bumps.
Environment=PATH=/root/.nvm/versions/node/v22.22.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/.nvm/versions/node/v22.22.2/bin/pnpm start
Restart=always
RestartSec=5
# Capture stdout/stderr into the systemd journal; `journalctl -u sonar -f`
# tails live logs without needing a separate log file path.
StandardOutput=journal
StandardError=journal
# Wait up to 60s for graceful shutdown so an in-flight agent cycle (which
# can run 30-60s) does not get killed mid-fill on a `systemctl restart`.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
